ENVIRONMENT=development
DATABASE_URL=sqlite:///./data/wordstream.db
APP_TIMEZONE=Asia/Shanghai
TTS_RATE=1.0
IMPORT_MAX_BYTES=5242880

# Local development may use disabled. Production must use password.
AUTH_MODE=disabled

# Required for password auth; SECRET_KEY must contain at least 32 characters.
SECRET_KEY=
APP_PASSWORD=

# Optional for direct API automation. Browser sessions use password login.
APP_API_KEY=
