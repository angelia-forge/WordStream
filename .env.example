ENVIRONMENT=development
DATABASE_URL=sqlite:///./data/wordstream.db
APP_TIMEZONE=Asia/Shanghai

# Local development may use disabled. Production must use password.
AUTH_MODE=disabled

# Generate with:
# python -c "from pwdlib import PasswordHash; print(PasswordHash.recommended().hash('change-me'))"
APP_PASSWORD_HASH=
SECRET_KEY=

# Optional for direct API automation. Browser sessions use password login.
APP_API_KEY=
