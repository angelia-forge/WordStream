app = "replace-with-your-wordstream-app"
primary_region = "nrt"

[build]
  dockerfile = "Dockerfile"

[env]
  APP_TIMEZONE = "Asia/Shanghai"
  AUTH_MODE = "password"
  DATABASE_URL = "sqlite:////data/wordstream.db"
  ENVIRONMENT = "production"

[http_service]
  internal_port = 8000
  force_https = true
  auto_stop_machines = false
  auto_start_machines = true
  min_machines_running = 1

  [[http_service.checks]]
    interval = "15s"
    timeout = "5s"
    grace_period = "20s"
    method = "GET"
    path = "/api/v1/health"

[[mounts]]
  source = "wordstream_data"
  destination = "/data"
